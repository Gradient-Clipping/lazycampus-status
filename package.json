{
  "name": "lazycampus-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "dev": "vite --config web/vite.config.mjs --host 127.0.0.1",
    "build": "vite build --config web/vite.config.mjs",
    "check": "eslint server web/src test && prettier --check .",
    "format": "prettier --write .",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:ui": "vitest run --config web/vite.config.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "cron-parser": "5.4.0",
    "fastify": "5.12.4",
    "jose": "6.2.10",
    "mysql2": "3.23.3",
    "openid-client": "6.8.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
